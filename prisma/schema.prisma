generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  email         String         @unique
  name          String?
  createdAt     DateTime       @default(now())
  bio           String?
  facebookUrl   String?
  firstName     String?
  instagramUrl  String?
  lastName      String?
  location      String?
  tiktokUrl     String?
  username      String?        @unique
  youtubeUrl    String?
  avatarUrl     String?
  avatarOptions Json?
  avatarSeed    String?
  chats         Chat[]
  contributions Contribution[]
  journeys      Journey[]
  favorites     POIFavorite[]
  reviews       POIReview[]
  vouches       POIVouch[]
}

model POI {
  id             String           @id @default(cuid())
  name           String
  description    String
  latitude       Float
  longitude      Float
  vouchCount     Int              @default(0)
  /// 1 (budget) to 4 (luxury) price tier for filtering.
  priceLevel     Int?
  primaryTagId   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  email          String?
  phoneNumber    String?
  contributions  Contribution[]
  itineraryItems ItineraryItem[]
  operatingHours OperatingHours[]
  primaryTag     POITag?          @relation("POIPrimaryTag", fields: [primaryTagId], references: [id])
  address        POIAddress?
  favorites      POIFavorite[]
  galleries      POIGallery[]
  links          POILink[]
  reviews        POIReview[]
  vouches        POIVouch[]
  tags           POITag[]         @relation("POITags")

  @@index([primaryTagId])
}

model POILink {
  id    String @id @default(cuid())
  poiId String
  label String
  url   String
  poi   POI    @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([poiId])
}

model POIAddress {
  id               String   @id @default(cuid())
  poiId            String   @unique
  blockLotNumber   String?
  houseNumber      String?
  purok            String?
  street           String?
  subdivisionName  String?
  barangay         String?
  cityMunicipality String?
  province         String?
  postalCode       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  poi              POI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
}

model POITagCluster {
  id        String   @id
  name      String   @unique
  iconName  String
  createdAt DateTime @default(now())
  tags      POITag[]
}

model POITag {
  id             String         @id
  name           String         @unique
  iconName       String?
  clusterId      String?
  primaryForPOIs POI[]          @relation("POIPrimaryTag")
  cluster        POITagCluster? @relation(fields: [clusterId], references: [id])
  pois           POI[]          @relation("POITags")
}

model POIGallery {
  poiId     String
  imageUrl  String
  createdAt DateTime @default(now())
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poi       POI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
}

model OperatingHours {
  id        String  @id @default(cuid())
  poiId     String
  dayOfWeek Int
  openTime  String?
  closeTime String?
  isClosed  Boolean @default(false)
  is24Hours Boolean @default(false)
  poi       POI     @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@unique([poiId, dayOfWeek])
}

model POIReview {
  id        String             @id @default(cuid())
  poiId     String
  userId    String
  rating    Int
  content   String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  poi       POI                @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  history   POIReviewHistory[]
}

model POIReviewHistory {
  id              String    @id @default(cuid())
  reviewId        String
  previousContent String
  previousRating  Int
  changedAt       DateTime  @default(now())
  review          POIReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model POIVouch {
  id        String   @id @default(cuid())
  poiId     String
  userId    String
  createdAt DateTime @default(now())
  poi       POI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poiId, userId])
}

model POIFavorite {
  id        String   @id @default(cuid())
  poiId     String
  userId    String
  createdAt DateTime @default(now())
  poi       POI      @relation(fields: [poiId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([poiId, userId])
}

model Journey {
  id              String          @id @default(cuid())
  userId          String?
  title           String
  description     String?
  destination     String?
  startDate       DateTime?
  endDate         DateTime?
  isFlexibleDates Boolean         @default(false)
  companions      String?
  preferences     String?
  budget          Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  flexibleDays    Int?
  flexibleMonths  String?
  chats           Chat[]
  itineraryItems  ItineraryItem[]
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            JourneyDay[]
}

model JourneyDay {
  id        String  @id @default(cuid())
  journeyId String
  dayNumber Int
  title     String?
  journey   Journey @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@unique([journeyId, dayNumber])
  @@index([journeyId])
}

model Chat {
  id        String    @id @default(cuid())
  journeyId String?
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String?
  journey   Journey?  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model ItineraryItem {
  id         String   @id @default(cuid())
  journeyId  String
  poiId      String
  dayNumber  Int?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  endTime    String?
  notes      String?
  startTime  String?
  journey    Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  poi        POI      @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@index([journeyId, dayNumber, orderIndex])
}

model Contribution {
  id           String             @id @default(cuid())
  userId       String
  type         ContributionType
  status       ContributionStatus @default(PENDING)
  /// Full POI payload (name, description, coords, tags, hours, address)
  proposedData Json
  /// Only set when type === UPDATE — links to the POI being edited
  poiId        String?
  /// Optional rejection/approval notes from the admin
  adminNotes   String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  poi          POI?               @relation(fields: [poiId], references: [id])
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContributionType {
  CREATE
  UPDATE
}
